set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSROOT "$ENV{TARGET_SYSROOT}")
set(CMAKE_C_COMPILER "$ENV{CROSS_WRAPPER_DIR}/cc")
set(CMAKE_CXX_COMPILER "$ENV{CROSS_WRAPPER_DIR}/cxx")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
foreach(language C CXX)
    set(MPI_${language}_HEADER_DIR "$ENV{CROSS_MPI}/include" CACHE PATH "")
    set(MPI_${language}_LIB_NAMES mpi CACHE STRING "")
endforeach()
set(MPI_mpi_LIBRARY "$ENV{CROSS_MPI}/lib/libmpi.so" CACHE FILEPATH "")
set(MPI_CXX_COMPILE_DEFINITIONS OMPI_SKIP_MPICXX CACHE STRING "")
